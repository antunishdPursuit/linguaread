{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linguaread-language-broker",
  "main": "broker/src/index.ts",
  "compatibility_date": "2026-08-04",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },
  "vars": {
    "ALLOWED_ORIGINS": "chrome-extension://gamafmmbahlngeohnckiafmpmmgodggk,chrome-extension://ginclnkpgbmnjbmlefdkhiokcnplkcjm",
    "DAILY_ALLOWANCE_ENABLED": "true"
  },
  "secrets": {
    "required": [
      "GEMINI_API_KEY"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DAILY_ALLOWANCE",
        "class_name": "DailyAnalysisAllowance"
      }
    ]
  },
  "exports": {
    "DailyAnalysisAllowance": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "20260804",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
