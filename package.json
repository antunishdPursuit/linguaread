{
  "name": "linguaread",
  "description": "A PDF-first Chrome reading aid for Mandarin-speaking English learners.",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "broker:check": "wrangler deploy --dry-run",
    "broker:dev": "wrangler dev",
    "compile": "tsc --noEmit && tsc --noEmit -p broker/tsconfig.json && tsc --noEmit -p broker/runtime-tsconfig.json",
    "dictionary:ecdict": "python scripts/build_ecdict.py",
    "test": "vitest run && vitest run --config vitest.worker.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest",
    "zip": "wxt zip",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "pdfjs-dist": "5.4.296",
    "pinyin-pro": "3.28.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-pdf": "^10.4.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20261101.1",
    "@types/chrome": "^0.1.36",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@wxt-dev/module-react": "^1.1.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.0",
    "wxt": "^0.21.5"
  }
}
